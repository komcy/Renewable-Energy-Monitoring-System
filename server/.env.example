# Copy this file to .env and fill in real values. Never commit .env.

PORT=5000
# development | production (production also serves client/dist and requires a strong JWT_SECRET)
NODE_ENV=development

# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster-name>.<id>.mongodb.net/rems?retryWrites=true&w=majority&appName=<cluster-name>

# JWT signing secret: use a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# Allowed browser origins for CORS, comma-separated (Vite dev server by default)
CLIENT_URL=http://localhost:5173

# Set to 1 when running behind a reverse proxy so rate limits see real client IPs
TRUST_PROXY=
# Requests per 15 minutes per IP: failed sign-in attempts / whole API
AUTH_RATE_LIMIT=20
API_RATE_LIMIT=3000

# Telemetry simulator (optional)
SIM_TIMEZONE=Asia/Kolkata
SIMULATOR_AUTOSTART=false
SIMULATOR_INTERVAL_SECONDS=10
SIMULATOR_TIME_SCALE=1
