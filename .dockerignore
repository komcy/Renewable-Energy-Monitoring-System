# Keep the build context small and secrets out of the image

# Dependencies and build output (rebuilt inside the image)
**/node_modules
**/dist
**/build
**/coverage

# Secrets: provide at runtime with --env-file / env_file instead
**/.env
**/.env.*
!**/.env.example

# VCS, editor and tooling
.git
.gitignore
.claude
.vscode
.idea
**/*.log
**/.DS_Store

# Not needed at runtime
**/test
**/*.test.js
README.md
client/README.md
*.png
Dockerfile
docker-compose*.yml
.dockerignore
